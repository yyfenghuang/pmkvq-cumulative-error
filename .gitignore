# Python
__pycache__/
*.py[cod]
.venv/
.uv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Results and assets are produced by real execution and regenerated by the
# ladder; keep the directories (via .gitkeep) but not their contents.
results/*.csv
results/*.json
assets/*.png
assets/*.gif
!results/.gitkeep
!assets/.gitkeep

# The frozen predictions and their lock ARE committed.
!predictions/h1_predictions.json
!predictions/h1_predictions.lock.json
